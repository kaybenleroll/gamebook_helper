{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json; d=json.load(sys.stdin); c=d.get('command',''); p=[x for x in ['playwright','test-e2e','just test-all','just test '] if x in c]; print('\\n⚠️  DELEGATION CHECK: verification/test commands belong in a subagent per CLAUDE.md. If this is the main thread, stop and spawn a general-purpose subagent instead.\\n') if p else None\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git checkout*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(git merge-tree*)",
      "Bash(gh issue*)",
      "Bash(gh pr*)",
      "Bash(gh label*)",
      "Bash(gh api*)",
      "Bash(podman *)",
      "Bash(podman-compose *)",
      "Bash(just dev-start*)",
      "Bash(just dev-stop*)",
      "Bash(just test*)",
      "Bash(just rebuild*)",
      "Bash(just logs*)",
      "Bash(just db-reset*)",
      "Bash(just db-seed*)",
      "Bash(just demo-build*)",
      "Bash(just branch*)",
      "Bash(just clean*)",
      "Bash(npm install*)",
      "Bash(npm run*)",
      "Bash(npm ci*)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(mkdir -p *)",
      "Bash(ls*)",
      "Bash(curl -s*)",
      "Bash(curl --*)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(sort*)",
      "Bash(sleep *)",
      "Bash(find *)",
      "Bash(xargs *)",
      "Bash(command rm -f *)"
    ]
  }
}
